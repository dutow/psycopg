# Copy to .env to customize local development settings.
# .env is gitignored and should not be committed.

# Path to the Python virtual environment (default: .venv)
#VENV_DIR=.venv

# psycopg implementation to use for tests: python or c (default: python)
#PSYCOPG_IMPL=python

# PostgreSQL connection string for tests (default: dbname=psycopg_test)
#PSYCOPG_TEST_DSN=dbname=psycopg_test
